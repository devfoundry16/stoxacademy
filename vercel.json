{
  "version": 2,
  "projects": [
    {
      "rootDirectory": "apps/web",
      "builds": [
        { "src": "package.json", "use": "@vercel/next" }
      ],
      "routes": [
        { "src": "/api/(.*)", "dest": "../../apps/api/$1" },
        { "src": "/(.*)", "dest": "/$1" }
      ]
    }
  ]
}
